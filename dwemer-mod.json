{
  "schema_version": 1,
  "id": "example-server",
  "name": "Example AI Server",
  "description": "Small PHP and PostgreSQL example server for building your own AI mod.",
  "project_url": "https://github.com/Dwemer-Dynamics/ExampleServer",
  "dashboard_path": "ui/",
  "health_path": "health.php",
  "requirements": { "php": "8.2", "postgresql": true },
  "setup": {
    "config_template": "config/config.example.php",
    "config_path": "config/config.php",
    "token_placeholder": "CHANGE_ME_TOKEN",
    "database_placeholder": "example_ai_mod",
    "migrate_script": "scripts/migrate.php"
  },
  "branches": { "default": "main", "allowed": ["main", "dev"] },
  "assets": {
    "icon": "ui/images/question-mark.png",
    "banner": "ui/images/question-mark.png"
  }
}
